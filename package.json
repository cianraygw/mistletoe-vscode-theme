{
  "name": "mistletoe-theme",
  "displayName": "Mistletoe Theme",
  "description": "A cozy Christmas color theme: evergreen nights, holly-berry keywords, gold-star functions, Christmas-light brackets and a fresh-snow light variant.",
  "version": "1.0.0",
  "publisher": "cianray",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0f1a17",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cianraygw/mistletoe-vscode-theme"
  },
  "bugs": {
    "url": "https://github.com/cianraygw/mistletoe-vscode-theme/issues"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "christmas",
    "xmas",
    "holiday",
    "festive",
    "winter",
    "snow",
    "mistletoe",
    "dark",
    "light",
    "theme",
    "color-theme"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Mistletoe Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/mistletoe-midnight-color-theme.json"
      },
      {
        "label": "Mistletoe Frost",
        "uiTheme": "vs",
        "path": "./themes/mistletoe-frost-color-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "node scripts/preview.mjs",
    "package": "npm run build && vsce package",
    "publish:vsce": "npm run build && vsce publish",
    "publish:ovsx": "npm run build && ovsx publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.0",
    "ovsx": "^1.3.0",
    "shiki": "^4.6.0"
  }
}
